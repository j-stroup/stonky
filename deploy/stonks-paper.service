[Unit]
Description=stonks: once-a-day paper trade
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=__USER__
WorkingDirectory=__DIR__
ExecStart=__DIR__/.venv/bin/python __DIR__/paper_trade.py alpaca
TimeoutStartSec=15min
# Refresh the web report after every run, even a failed one.
ExecStopPost=-+/usr/bin/systemctl start --no-block stonks-report.service
